<% contexts = JobContext::Dashboard.context_for(job) %>
<% if contexts.present? %>
  <div class="mt-3">
    <div class="small text-muted">Context attributes</div>
    <table class="table table-sm mb-0">
      <tbody>
        <% contexts.each do |name, values| %>
          <tr>
            <th scope="row"><%= name %></th>
            <td><%= tag.pre JSON.pretty_generate(values), class: "small mb-0" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
